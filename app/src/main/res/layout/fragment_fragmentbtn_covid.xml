<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    tools:context=".FragmentbtnCovid">

    <LinearLayout
        android:id="@+id/layoutSegmented"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/shape_segment_container"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/buttoncovid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/shape_segment_pill_inactive"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="COVID-19"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/buttonnoncovid"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/shape_segment_pill_active"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="NON COVID-19"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
