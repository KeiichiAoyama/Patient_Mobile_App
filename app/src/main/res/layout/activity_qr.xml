<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    tools:context=".QrActivity">

    <LinearLayout
        android:id="@+id/custom_header"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/bg_main"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Icon -->
        <ImageView
            android:id="@+id/header_back"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/shape_header_action_btn"
            android:contentDescription="Kembali"
            android:padding="9dp"
            android:src="@drawable/ion_chevron_back"
            app:tint="@color/textPrimary" />

        <!-- Title -->
        <TextView
            android:id="@+id/header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Pindai Kode QR"
            android:textColor="@color/textPrimary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Right Icon -->
        <ImageView
            android:id="@+id/header_icon_right"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/shape_header_action_btn"
            android:contentDescription="Bantuan"
            android:padding="9dp"
            android:src="@drawable/help_button"
            app:tint="@color/textPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="32dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/custom_header">

        <!-- Scanner Viewfinder Card -->
        <FrameLayout
            android:layout_width="260dp"
            android:layout_height="260dp"
            android:background="@drawable/shape_bulletin_card"
            android:elevation="6dp"
            android:padding="20dp">

            <ImageView
                android:id="@+id/imageView26"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_card_feature_blue"
                android:contentDescription="Area Pindai"
                android:padding="32dp"
                android:src="@drawable/fluent_scan_table_20_regular"
                app:tint="@color/biruNeon" />
        </FrameLayout>

        <!-- Instructions -->
        <TextView
            android:id="@+id/textView14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:lineSpacingExtra="3dp"
            android:text="Arahkan kamera ke kode QR di meja faskes untuk check-in, check-out, atau memberikan penilaian dokter."
            android:textAlignment="center"
            android:textColor="@color/textSecondary"
            android:textSize="14sp" />

        <!-- Flash button -->
        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginTop="36dp"
            android:background="@drawable/shape_header_action_btn"
            android:contentDescription="Senter / Flash"
            android:elevation="3dp"
            android:padding="12dp"
            android:src="@drawable/flash_button"
            app:tint="@color/biruNeon" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
